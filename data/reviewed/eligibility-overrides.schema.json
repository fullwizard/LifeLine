{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LifeLine reviewed eligibility overrides",
  "type": "object",
  "properties": {
    "description": { "type": "string" },
    "overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["reviewed_at", "reviewed_by"],
        "properties": {
          "reviewed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "reviewed_by": { "type": "string" },
          "active": { "type": "boolean" },
          "eligibility_verified": { "type": "boolean" },
          "phone": { "type": "string" },
          "response_time_days": { "type": "number", "minimum": 0 },
          "required_documents": { "type": "array", "items": { "type": "string" } },
          "eligibility": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_annual_income": { "type": "number" },
              "max_ami_percent": { "type": "number" },
              "max_fpl_percent": { "type": "number" },
              "requires_eviction_notice": { "type": "boolean" },
              "requires_children": { "type": "boolean" },
              "requires_veteran": { "type": "boolean" },
              "housing_status_any_of": {
                "type": "array",
                "items": { "enum": ["housed_stable", "housed_at_risk", "eviction_notice", "unhoused"] }
              },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
